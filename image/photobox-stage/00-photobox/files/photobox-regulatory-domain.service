[Unit]
Description=Set Wi-Fi regulatory domain for Photobox
Wants=photobox-first-boot.service
After=photobox-first-boot.service
Before=NetworkManager.service
ConditionPathExists=/etc/photobox/device.env

[Service]
Type=oneshot
EnvironmentFile=/etc/photobox/device.env
ExecStart=/usr/sbin/iw reg set ${PHOTOBOX_WIFI_COUNTRY}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
