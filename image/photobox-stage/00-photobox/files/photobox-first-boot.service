[Unit]
Description=Install Photobox first-boot configuration
RequiresMountsFor=/boot/firmware
After=local-fs.target
Before=photobox-regulatory-domain.service NetworkManager.service photobox.service
ConditionPathExists=/boot/firmware/photobox-device.json

[Service]
Type=oneshot
ExecStart=/opt/photobox/venv/bin/python -m photobox.first_boot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target